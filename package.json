{
  "name": "halaverga",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "make:qr": "pnpm dlx qrcode -t svg -w 300 -o public/qr-deployment.svg https://halaverga-flight.vercel.app"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "@react-three/rapier": "2.2.0",
    "next": "16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.183.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@dimforge/rapier3d-compat": "0.19.2",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.183.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
